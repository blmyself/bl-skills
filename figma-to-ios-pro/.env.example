# ========================================================
# Figma to iOS Pro - 本地环境配置模板
# 使用方法：复制本文件为 .env 并填入真实 Token 即可
# 命令示例：cp .env.example .env
# ========================================================

# [必填] Figma Personal Access Token
# 获取地址: https://www.figma.com/developers/api#access-tokens
# 权限要求：勾选 file_content:read 与 file_metadata:read
FIGMA_ACCESS_TOKEN=figd_your_personal_access_token_here

# [可选] 兼容字段（如果已设置 FIGMA_ACCESS_TOKEN 则无需设置此项）
# FIGMA_TOKEN=figd_your_personal_access_token_here

# [可选] 团队 Figma 账号级别，用于校准 API 漏桶限速配额 (默认: pro)
# 可选值: pro | org | enterprise | view | starter (注: view/starter 会启用月度 6 次硬记账保护)
# FIGMA_PLAN=pro

# [可选] 限流安全系数，默认只使用官方额度的 80% 避免偶发突发流量踩线 (范围: 0.1 ~ 1.0)
# FIGMA_RATE_SAFETY=0.8

# [可选] 缓存生存时长 (单位: 秒，默认: 604800 即 7 天，0 表示禁用缓存，负数表示永久缓存)
# FIGMA_CACHE_TTL=604800
